# Auto-detect text files, store them as LF and also check them out as LF on
# every OS (including Windows with core.autocrlf=true). Prettier enforces
# "endOfLine": "lf", so CRLF checkouts made `npm run lint` fail after a pull.
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized
*.js text
*.css text
*.html text

# Declare files that will always be CRLF (e.g., Windows batch files)
*.bat text eol=crlf

# Declare binary files so Git doesn't touch them
*.png binary
*.jpg binary